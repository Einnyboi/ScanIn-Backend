DATABASE_URL="postgresql://postgres:password@localhost:5432/scanin_db?schema=public"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="7d"
PORT=3000
FRONTEND_URL="http://127.0.0.1:5173"

# Reset password email sender.
# Gmail: gunakan App Password, bukan password login biasa.
# Backend juga membaca alias MAIL_USER/MAIL_PASS/MAIL_FROM dan EMAIL_USER/EMAIL_PASS/EMAIL_FROM.
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME="Admin Fakultas Teknologi Informasi UNTAR"
SMTP_USER="your_sender_email@gmail.com"
SMTP_PASS="your_16_digit_app_password"
SMTP_FROM="Admin Fakultas Teknologi Informasi UNTAR <your_sender_email@gmail.com>"

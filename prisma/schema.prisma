generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pengguna {
  id         String       @id @default(cuid())
  username   String       @unique
  password   String
  nama       String
  role       Role
  isAktif    Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  mahasiswa  Mahasiswa?
  pengajar   Pengajar?
  permohonan Permohonan[]

  @@map("pengguna")
}

model Mahasiswa {
  id           String         @id @default(cuid())
  nim          String         @unique
  angkatan     String
  penggunaId   String         @unique
  tipeKelas    TipeKelas
  kelasRombel  String?
  dataPresensi DataPresensi[]
  kelasAssignments MahasiswaKelas[]
  pengguna     Pengguna       @relation(fields: [penggunaId], references: [id])

  @@map("mahasiswa")
}

model Pengajar {
  id           String         @id @default(cuid())
  nip          String         @unique
  penggunaId   String         @unique
  pengguna     Pengguna       @relation(fields: [penggunaId], references: [id])
  sesiPresensi SesiPresensi[]
  jadwal       Jadwal[]

  @@map("pengajar")
}

model MataKuliah {
  id         String  @id @default(cuid())
  idMatkul   String  @unique
  kodeMatkul String  @unique
  namaMatkul String
  sks        Int
  kelas      Kelas[]

  @@map("mata_kuliah")
}

model Ruangan {
  id          String   @id @default(cuid())
  idRuangan   String   @unique
  namaRuangan String
  jadwal      Jadwal[]

  @@map("ruangan")
}

model Kelas {
  id           String     @id @default(cuid())
  idKelas      String     @unique
  namaKelas    String
  mataKuliahId String
  jadwal       Jadwal[]
  mahasiswaAssignments MahasiswaKelas[]
  mataKuliah   MataKuliah @relation(fields: [mataKuliahId], references: [id])

  @@map("kelas")
}

model MahasiswaKelas {
  id          String    @id @default(cuid())
  mahasiswaId String
  kelasId     String
  isOverride  Boolean   @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id])
  kelas       Kelas     @relation(fields: [kelasId], references: [id])

  @@unique([mahasiswaId, kelasId])
  @@map("mahasiswa_kelas")
}

model Jadwal {
  id           String         @id @default(cuid())
  idJadwal     String         @unique
  hari         String
  jamMulai     DateTime
  jamSelesai   DateTime
  kelasId      String
  ruanganId    String
  pengajarId   String?
  kelas        Kelas          @relation(fields: [kelasId], references: [id])
  ruangan      Ruangan        @relation(fields: [ruanganId], references: [id])
  pengajar     Pengajar?      @relation(fields: [pengajarId], references: [id])
  sesiPresensi SesiPresensi[]

  @@map("jadwal")
}

model SesiPresensi {
  id           String         @id @default(cuid())
  idSesi       String         @unique @default(cuid())
  jadwalId     String
  pengajarId   String
  qrToken      String         @unique
  waktuBuka    DateTime       @default(now())
  autoCloseAt  DateTime
  statusSesi   StatusSesi     @default(AKTIF)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dataPresensi DataPresensi[]
  jadwal       Jadwal         @relation(fields: [jadwalId], references: [id])
  pengajar     Pengajar       @relation(fields: [pengajarId], references: [id])

  @@map("sesi_presensi")
}

model DataPresensi {
  id              String          @id @default(cuid())
  idPresensi      String          @unique @default(cuid())
  mahasiswaId     String
  sesiId          String
  statusKehadiran StatusKehadiran
  metodeInput     MetodeInput
  waktuAbsen      DateTime        @default(now())
  fileBukti       String?
  geoLat          Float?
  geoLng          Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  mahasiswa       Mahasiswa       @relation(fields: [mahasiswaId], references: [id])
  sesiPresensi    SesiPresensi    @relation(fields: [sesiId], references: [id])

  @@unique([mahasiswaId, sesiId])
  @@map("data_presensi")
}

model Permohonan {
  id               String           @id @default(cuid())
  idPermohonan     String           @unique @default(cuid())
  penggunaId       String
  jenisPermohonan  JenisPermohonan
  deskripsiMasalah String
  tanggalKelas     DateTime
  fileBukti        String?
  status           StatusPermohonan @default(MENUNGGU_DIPROSES)
  catatanReview    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  pengguna         Pengguna         @relation(fields: [penggunaId], references: [id])

  @@map("permohonan")
}

model AuditLog {
  id         String   @id @default(cuid())
  penggunaId String
  aksi       String
  tabel      String
  dataLama   Json?
  dataBaru   Json?
  createdAt  DateTime @default(now())

  @@map("audit_log")
}

enum Role {
  ADMIN
  DOSEN
  ASDOS
  MAHASISWA
}

enum TipeKelas {
  PAGI
  SORE
}

enum StatusKehadiran {
  HADIR
  TERLAMBAT
  TIDAK_HADIR
  MENUNGGU_VALIDASI
  DITOLAK
}

enum MetodeInput {
  QR
  MANUAL
  UPLOAD
}

enum StatusSesi {
  AKTIF
  DITUTUP_MANUAL
  DITUTUP_SISTEM
}

enum StatusPermohonan {
  MENUNGGU_DIPROSES
  SELESAI
  DITOLAK
}

enum JenisPermohonan {
  KELUHAN_ABSENSI
  DATA_ERROR
  DISPENSASI
  LAINNYA
}
